# Copy to .env and fill in. docker compose reads .env from this directory.

# The password everyone types to get in.
BOARD_PASSWORD=

# Signs the login cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it logs out every device.
SECRET_KEY=

# Where the app's port is published. 127.0.0.1 means only this machine, which is
# what Tailscale Serve needs. 0.0.0.0 serves it on your LAN too (see the README).
BIND_ADDRESS=127.0.0.1

# Set to 1 only if you reach the app over plain http://, such as on your LAN.
ALLOW_HTTP=0
